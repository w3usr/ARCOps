# Development environment for ops.w3usr.org. Copy to .env (gitignored). Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-not-secret
# Optional: point at a club overlay directory laid out like config/ (TR-41)
# CLUB_OVERLAY_DIR=/path/to/club-assets
# The nightly encrypted backup (TR-22), on a server that schedules it. With no recipient the job
# writes nothing and the status page does not watch it (technical addendum A11).
# BACKUP_DIR=/path/to/backups
# BACKUP_AGE_RECIPIENT=age1...the public half of the key that decrypts them
# BACKUP_NAME=ops_backup
